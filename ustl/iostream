inline stdistream & operator >> (stdistream & os,char & ch){
  ch=getchar();
  return os;
}

inline stdistream & operator >> (stdistream & os,char * s){
  int i;
  for (i=0;i<255;i++){
    char ch; os >> ch;
    if (ch<32 || ch>=127)
      break;
    s[i]=ch;
  }
  s[i]=0;
  return os;
}

inline stdistream & operator >> (stdistream & os,int & i){
